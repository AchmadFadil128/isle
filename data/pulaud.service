[Unit]
Description=Pulau dynamic island service
Documentation=file://%h/.local/share/doc/pulau/README.md
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=io.github.pulau.Daemon
ExecStart=@BINDIR@/pulaud
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
